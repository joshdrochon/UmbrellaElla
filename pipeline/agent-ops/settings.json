{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Edit(./tools/**)",
      "Edit(./tests/**)",
      "Edit(./.github/**)",
      "Edit(./evals/README.md)",
      "Edit(./evals/reviewer/cases/**)",
      "Edit(./evals/reviewer/results.md)",
      "Edit(./evals/art-judge/**)",
      "Edit(./pipeline/roles/**)",
      "Edit(./pipeline/agent-ops/**)",
      "Edit(./pipeline/art/style.json)",
      "Edit(./pipeline/audio/style.json)",
      "Edit(./pipeline/audio/sound-events.json)",
      "Edit(./pipeline/story/story.json)",
      "Edit(./evals/story-critic/**)",
      "Edit(./.claude/**)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./.mcp.json)",
      "Edit(./.gitattributes)",
      "Edit(./.gitignore)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch",
      "WebSearch"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh api *)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/pipeline/agent-ops/hook.py\" guard",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/pipeline/agent-ops/journal_hook.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/pipeline/agent-ops/hook.py\" log",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/pipeline/agent-ops/journal_hook.py\" bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/pipeline/agent-ops/hook.py\" log",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/pipeline/agent-ops/journal_hook.py\" bash",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/pipeline/agent-ops/hook.py\" log",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/pipeline/agent-ops/hook.py\" log",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/pipeline/agent-ops/journal_hook.py\" stop",
            "timeout": 10
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/pipeline/agent-ops/hook.py\" config",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
