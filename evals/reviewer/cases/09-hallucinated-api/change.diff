+void UFeedbackAdapterComponent::HandleHealthChanged(const FGameEventInfo& Info, int32 OldHealth, int32 NewHealth) const
+{
+	if (NewHealth >= OldHealth) { return; }
+	const APaperCharacter* Ella = Cast<APaperCharacter>(GetOwner());
+	if (!IsValid(Ella)) { return; }
+	Ella->GetSprite()->PlayAnimation(HurtFlipbook, false);
+	UGameplayStatics::PlayOneShot2D(this, HurtSound);
+}
