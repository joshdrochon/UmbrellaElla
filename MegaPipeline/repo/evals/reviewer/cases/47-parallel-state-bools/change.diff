@@ -50,12 +50,20 @@
 EUmbrellaConfig UUmbrellaStateComponent::GetConfig() const
 {
-	return EUmbrellaConfig::UpOpen;
+	return bUpOpen ? EUmbrellaConfig::UpOpen : EUmbrellaConfig::AttackDescent;
 }
 
 void UUmbrellaStateComponent::RequestOpen()
 {
+	if (bUpOpen) { return; }
+	bUpOpen = true;
+	bFalling = false;
+	BroadcastConfigChanged();
 }
 
 void UUmbrellaStateComponent::RequestClose()
 {
+	if (!bUpOpen) { return; }
+	bUpOpen = false;
+	bFalling = Movement.IsValid() && Movement->IsFalling();
+	BroadcastConfigChanged();
 }
