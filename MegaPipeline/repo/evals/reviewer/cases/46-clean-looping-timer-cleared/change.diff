 void UFeedbackAdapterComponent::BeginPlay()
 {
 	Super::BeginPlay();
 	BindToEvents();
+	const FFeedbackTuning& Tuning = GetDefault<UUmbrellaTuning>()->Feedback;
+	GetWorld()->GetTimerManager().SetTimer(WindLoopTimer, this, &UFeedbackAdapterComponent::UpdateWindLoop, Tuning.WindUpdateSeconds, true);
 }
 
 void UFeedbackAdapterComponent::EndPlay(const EEndPlayReason::Type EndPlayReason)
 {
+	GetWorld()->GetTimerManager().ClearTimer(WindLoopTimer);
 	UnbindFromEvents();
 	Super::EndPlay(EndPlayReason);
 }
 
+void UFeedbackAdapterComponent::UpdateWindLoop() const
+{
+	if (!IsValid(WindAudio)) { return; }
+	const AWindField* Field = WindField.Get();
+	const bool bWindOn = Harness.IsValid() && Harness->IsFeatureEnabled(EFeatureId::WIND_01) && IsValid(Field);
+	const float Force = bWindOn ? Field->GetForceAt(GetOwner()->GetActorLocation()).Size() : 0.f;
+	WindAudio->SetVolumeMultiplier(FFeedbackRules::WindVolume(Force, GetDefault<UUmbrellaTuning>()->Feedback));
+}
