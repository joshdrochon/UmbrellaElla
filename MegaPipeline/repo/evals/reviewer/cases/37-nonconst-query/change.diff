+float UPlayerMotorComponent::ComputeLift()
+{
+	const UUmbrellaStateComponent* Umbrella = UmbrellaState.Get();
+	if (!IsValid(Umbrella) || Umbrella->GetConfig() != EUmbrellaConfig::UpOpen) { return 0.f; }
+	return GetDefault<UUmbrellaTuning>()->Motor.LiftAccel;
+}
